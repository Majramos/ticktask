Screen {
    layout: vertical;
    align: center middle;
    layers: background default overlay;
    background: #0f1115;
    color: #f2f4f8;
}

#project-background-name {
    layer: background;
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-style: bold;
    color: #7b8492;
    opacity: 20%;
}

#project-setup {
    width: 60;
    max-width: 90%;
    height: 20;
    border: round #566070;
    background: #1a212b;
    padding: 1 2;
    margin: 1 0;
}

#project-setup-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: #e2e8f0;
    margin-bottom: 1;
}

.project-setup-label {
    width: 100%;
    margin-top: 1;
    color: #cfd8e3;
}

#existing-project-select {
    width: 100%;
}

#new-project-input {
    width: 100%;
    margin-top: 1;
}

#project-continue {
    width: 100%;
    margin-top: 1;
}

#project-setup-error {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #fda4af;
}

#carousel {
    width: 100%;
    height: 18;
    align: center middle;
    padding: 1 2;
}

.timer-card {
    width: 18;
    height: 9;
    margin: 0 1;
    border: round #566070;
    background: #1a212b;
    content-align: center middle;
}

.slot-center {
    width: 28;
    height: 13;
    border: heavy #dbeafe;
}

.slot-side {
    width: 16;
    height: 8;
    offset: 0 2;
}

.slot-far {
    width: 14;
    height: 7;
    offset: 0 3;
    opacity: 75%;
}

.timer-name {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

.timer-value {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

.timer-position {
    width: 100%;
    content-align: center middle;
    color: #b7c0cd;
}

.past {
    background: #2b3038;
    border: round #727984;
    color: #9da4ae;
}

.future {
    color: #f8fafc;
}

.current {
    text-style: bold;
}

#status {
    dock: top;
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
    color: #d7dde7;
}

#current-project {
    dock: top;
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
    color: #cfd8e3;
}

#tasks-panel {
    width: 100%;
    align-horizontal: center;
}

#all-tasks-screen {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

#tasks-card {
    width: 96;
    max-width: 96%;
    height: 14;
    border: round #566070;
    background: #121a24;
    padding: 0 1;
    margin: 1 0;
}

#tasks-title {
    width: 100%;
    height: 1;
    text-style: bold;
    color: #e2e8f0;
    margin-bottom: 1;
}

#tasks-list {
    width: 100%;
    height: 1fr;
    color: #d7dde7;
}

#all-tasks-current-project {
    dock: top;
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
    color: #cfd8e3;
}

#all-tasks-card {
    width: 104;
    max-width: 96%;
    height: 1fr;
    min-height: 16;
    border: round #566070;
    background: #121a24;
    padding: 1 2;
    margin: 1 0;
}

#all-tasks-title {
    width: 100%;
    height: 1;
    text-style: bold;
    color: #e2e8f0;
}

#all-tasks-help {
    width: 100%;
    margin: 1 0;
    color: #9fb0c3;
}

#all-tasks-scroll {
    width: 100%;
    height: 1fr;
    border: round #334155;
    padding: 0 1;
    background: #0f1720;
}

#all-tasks-list {
    width: 100%;
    height: auto;
    color: #d7dde7;
}

#project-form-screen,
#task-form-screen {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

#task-form {
    width: 72;
    min-width: 56;
    max-width: 96;
    border: round #566070;
    background: #1a212b;
    padding: 1 2;
    height: auto;
}

#task-form > * {
    width: 100%;
}

#task-form-title {
    text-style: bold;
    color: #e2e8f0;
    content-align: center middle;
    margin-bottom: 1;
}

#task-description-input {
    min-height: 3;
    max-height: 12;
    overflow-y: auto;
}

#task-form-meta-row {
    layout: horizontal;
    width: 100%;
    margin-top: 1;
}

#task-priority-select,
#task-completed-checkbox,
#task-archived-checkbox {
    margin-top: 0;
    margin-bottom: 1;
}

#task-archived-checkbox {
    margin-bottom: 0;
}

#task-form-error {
    height: 1;
    margin-top: 1;
    color: #fda4af;
}

#task-form-help {
    margin-top: 1;
    color: #9fb0c3;
}

Button {
    width: 18;
    margin: 0 1;
}
